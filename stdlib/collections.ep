# ErnosPlain Collections Standard Library
# Implements HashMap, HashSet, Stack, Queue, Deque

# ---- External C Runtime Helpers ----
external define ep_hash_string with s:
external define ep_str_equals with a and b:
external define string_length with s:
external define get_character with s and idx:

# ════════════════════════════════════════════
# HashMap (Open addressing with linear probing)
# ════════════════════════════════════════════

# Internal constants
# Bucket layout: [key, value, occupied] per slot
# Total size = capacity * 3

define create_map:
    set capacity to 64
    set buckets to create_list()
    # Initialize buckets: key=0, value=0, occupied=0
    set i to 0
    repeat while i < capacity * 3:
        set ok to append_list(buckets and 0)
        set i to i + 1
    # Map structure: [buckets, size, capacity]
    set map to create_list()
    set ok to append_list(map and buckets)
    set ok to append_list(map and 0)
    set ok to append_list(map and capacity)
    return map

define map_hash with map and key:
    set capacity to get_list(map and 2)
    set h to ep_hash_string(key)
    # Ensure positive
    if h < 0:
        set h to 0 - h
    set h to h modulo capacity
    return h

define map_put with map and key and value:
    set buckets to get_list(map and 0)
    set size to get_list(map and 1)
    set capacity to get_list(map and 2)
    set idx to map_hash(map and key)
    set attempts to 0
    repeat while attempts < capacity:
        set base to idx * 3
        set occupied to get_list(buckets and base + 2)
        if occupied == 0:
            # Empty slot — insert
            set ok to set_list(buckets and base and key)
            set ok to set_list(buckets and base + 1 and value)
            set ok to set_list(buckets and base + 2 and 1)
            set ok to set_list(map and 1 and size + 1)
            return 1
        else:
            set existing_key to get_list(buckets and base)
            if ep_str_equals(existing_key and key) == 1:
                # Key exists — update value
                set ok to set_list(buckets and base + 1 and value)
                return 1
        set idx to (idx + 1) modulo capacity
        set attempts to attempts + 1
    # Map is full — should resize, but for now return error
    return 0

define map_get with map and key:
    set buckets to get_list(map and 0)
    set capacity to get_list(map and 2)
    set idx to map_hash(map and key)
    set attempts to 0
    repeat while attempts < capacity:
        set base to idx * 3
        set occupied to get_list(buckets and base + 2)
        if occupied == 0:
            return 0
        set existing_key to get_list(buckets and base)
        if ep_str_equals(existing_key and key) == 1:
            return get_list(buckets and base + 1)
        set idx to (idx + 1) modulo capacity
        set attempts to attempts + 1
    return 0

define map_has with map and key:
    set buckets to get_list(map and 0)
    set capacity to get_list(map and 2)
    set idx to map_hash(map and key)
    set attempts to 0
    repeat while attempts < capacity:
        set base to idx * 3
        set occupied to get_list(buckets and base + 2)
        if occupied == 0:
            return 0
        set existing_key to get_list(buckets and base)
        if ep_str_equals(existing_key and key) == 1:
            return 1
        set idx to (idx + 1) modulo capacity
        set attempts to attempts + 1
    return 0

define map_remove with map and key:
    set buckets to get_list(map and 0)
    set size to get_list(map and 1)
    set capacity to get_list(map and 2)
    set idx to map_hash(map and key)
    set attempts to 0
    repeat while attempts < capacity:
        set base to idx * 3
        set occupied to get_list(buckets and base + 2)
        if occupied == 0:
            return 0
        set existing_key to get_list(buckets and base)
        if ep_str_equals(existing_key and key) == 1:
            set ok to set_list(buckets and base + 2 and 0)
            set ok to set_list(map and 1 and size - 1)
            return 1
        set idx to (idx + 1) modulo capacity
        set attempts to attempts + 1
    return 0

define map_size with map:
    return get_list(map and 1)

define map_keys with map:
    set buckets to get_list(map and 0)
    set capacity to get_list(map and 2)
    set keys to create_list()
    set i to 0
    repeat while i < capacity:
        set base to i * 3
        set occupied to get_list(buckets and base + 2)
        if occupied == 1:
            set key to get_list(buckets and base)
            set ok to append_list(keys and key)
        set i to i + 1
    return keys

define map_values with map:
    set buckets to get_list(map and 0)
    set capacity to get_list(map and 2)
    set values to create_list()
    set i to 0
    repeat while i < capacity:
        set base to i * 3
        set occupied to get_list(buckets and base + 2)
        if occupied == 1:
            set val to get_list(buckets and base + 1)
            set ok to append_list(values and val)
        set i to i + 1
    return values

# ════════════════════════════════════════════
# HashSet (backed by HashMap)
# ════════════════════════════════════════════

define create_set:
    return create_map()

define set_add with s and value:
    return map_put(s and value and 1)

define set_has with s and value:
    return map_has(s and value)

define set_remove with s and value:
    return map_remove(s and value)

define set_size with s:
    return map_size(s)

define set_values with s:
    return map_keys(s)

# ════════════════════════════════════════════
# Stack (backed by list — LIFO)
# ════════════════════════════════════════════

define create_stack:
    return create_list()

define push_stack with s and value:
    set ok to append_list(s and value)
    return 1

define pop_stack with s:
    set len to length_list(s)
    if len == 0:
        return 0
    set val to get_list(s and len - 1)
    set ok to remove_list(s and len - 1)
    return val

define stack_peek with s:
    set len to length_list(s)
    if len == 0:
        return 0
    return get_list(s and len - 1)

define stack_size with s:
    return length_list(s)

define stack_is_empty with s:
    if length_list(s) == 0:
        return 1
    return 0

# ════════════════════════════════════════════
# Queue (backed by list — FIFO)
# ════════════════════════════════════════════

define create_queue:
    return create_list()

define enqueue with q and value:
    set ok to append_list(q and value)
    return 1

define dequeue with q:
    set len to length_list(q)
    if len == 0:
        return 0
    set val to get_list(q and 0)
    set ok to remove_list(q and 0)
    return val

define queue_peek with q:
    set len to length_list(q)
    if len == 0:
        return 0
    return get_list(q and 0)

define queue_size with q:
    return length_list(q)

define queue_is_empty with q:
    if length_list(q) == 0:
        return 1
    return 0

# ════════════════════════════════════════════
# Priority Queue (min-heap backed by list)
# ════════════════════════════════════════════

define create_priority_queue:
    return create_list()

define pq_push with pq and value:
    set ok to append_list(pq and value)
    # Sift up
    set idx to length_list(pq) - 1
    repeat while idx > 0:
        set parent to (idx - 1) / 2
        set parent_val to get_list(pq and parent)
        set child_val to get_list(pq and idx)
        if child_val < parent_val:
            set ok to set_list(pq and parent and child_val)
            set ok to set_list(pq and idx and parent_val)
            set idx to parent
        else:
            set idx to 0
    return 1

define pq_pop with pq:
    set len to length_list(pq)
    if len == 0:
        return 0
    set min_val to get_list(pq and 0)
    set last to get_list(pq and len - 1)
    set ok to remove_list(pq and len - 1)
    set len to len - 1
    if len > 0:
        set ok to set_list(pq and 0 and last)
        # Sift down
        set idx to 0
        set done to 0
        repeat while done == 0:
            set left to idx * 2 + 1
            set right to idx * 2 + 2
            set smallest to idx
            if left < len:
                if get_list(pq and left) < get_list(pq and smallest):
                    set smallest to left
            if right < len:
                if get_list(pq and right) < get_list(pq and smallest):
                    set smallest to right
            if smallest != idx:
                set tmp to get_list(pq and idx)
                set ok to set_list(pq and idx and get_list(pq and smallest))
                set ok to set_list(pq and smallest and tmp)
                set idx to smallest
            else:
                set done to 1
    return min_val

define pq_peek with pq:
    if length_list(pq) == 0:
        return 0
    return get_list(pq and 0)

define pq_size with pq:
    return length_list(pq)

# ════════════════════════════════════════════
# Iterator/Generator Protocol
# ════════════════════════════════════════════

define choice IterResult:
    variant Next with value as Any
    variant Done

define trait Iterator:
    define next returning IterResult
