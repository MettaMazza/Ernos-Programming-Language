    set ok to append_list(lines and "            EpGCObject* found = *cur;\n")
    set ok to append_list(lines and "            *cur = found->next;\n")
    set ok to append_list(lines and "            if (found->generation == 0) {\n")
    set ok to append_list(lines and "                ep_gc_nursery_count--;\n")
    set ok to append_list(lines and "            }\n")
    set ok to append_list(lines and "            free(found);\n")
