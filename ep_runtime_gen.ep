    set ok to append_list(lines and "    char* out = (char*)malloc(out_len + 1);\n")
    set ok to append_list(lines and "    size_t i, j = 0;\n")
    set ok to append_list(lines and "    for (i = 0; i < len; i += 3) {\n")
