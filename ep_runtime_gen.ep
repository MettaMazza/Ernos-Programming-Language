    set ok to append_list(lines and "            unsigned char first = (unsigned char)*p;\n")
    set ok to append_list(lines and "            if ((first >= 0x20 && first <= 0x7E) || (first >= 0xC0 && first <= 0xFD) || first == '\\n' || first == '\\t' || first == '\\r' || first == 0) {\n")
    set ok to append_list(lines and "                return val; // Readable memory, looks like a string\n")
    set ok to append_list(lines and "            }\n")
    set ok to append_list(lines and "        }\n")
    set ok to append_list(lines and "#elif defined(__APPLE__)\n")
    set ok to append_list(lines and "        // macOS: use vm_read_overwrite to safely probe\n")
