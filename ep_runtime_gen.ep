    set ok to append_list(lines and "        if (*p == ',') p++;\n")
    set ok to append_list(lines and "    }\n")
    set ok to append_list(lines and "    return NULL;\n")
    set ok to append_list(lines and "}\n")
    set ok to append_list(lines and "\n")
    set ok to append_list(lines and "long long json_get_string(long long json_val, long long key_val) {\n")
    set ok to append_list(lines and "    const char* json = (const char*)json_val;\n")
    set ok to append_list(lines and "    const char* key = (const char*)key_val;\n")
    set ok to append_list(lines and "    if (!json || !key) return (long long)strdup(\"\");\n")
    set ok to append_list(lines and "    const char* val = json_find_key(json, key);\n")
