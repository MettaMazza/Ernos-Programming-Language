    set ok to append_list(lines and "            long long val = chan->data[idx];\n")
    set ok to append_list(lines and "            if (val != 0) ep_gc_mark_object((void*)val);\n")
    set ok to append_list(lines and "        }\n")
    set ok to append_list(lines and "        ep_mutex_unlock(&chan->mutex);\n")
    set ok to append_list(lines and "    }\n")
    set ok to append_list(lines and "    pthread_mutex_unlock(&ep_channel_registry_mutex);\n")
    set ok to append_list(lines and "}\n")
    set ok to append_list(lines and "\n")
    set ok to append_list(lines and "static void ep_gc_scan_channels_minor_impl(void) {\n")
    set ok to append_list(lines and "    pthread_mutex_lock(&ep_channel_registry_mutex);\n")
