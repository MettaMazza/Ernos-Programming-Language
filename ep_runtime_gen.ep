    set ok to append_list(lines and "static pthread_cond_t ep_gc_resume_cond = PTHREAD_COND_INITIALIZER;\n")
    set ok to append_list(lines and "\n")
    set ok to append_list(lines and "/* Function pointer for channel scanning — set after EpChannel is defined.\n")
