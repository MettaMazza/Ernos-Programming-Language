    set ok to append_list(lines and "\n")
    set ok to append_list(lines and "long long ep_random_int(long long min, long long max) {\n")
    set ok to append_list(lines and "    if (max <= min) return min;\n")
    set ok to append_list(lines and "    /* Draw from the OS CSPRNG with rejection sampling to avoid modulo bias. */\n")
