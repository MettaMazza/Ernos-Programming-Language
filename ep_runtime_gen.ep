    set ok to append_list(lines and "#define EP_MAX_CHANNELS 1024\n")
    set ok to append_list(lines and "static EpChannel* ep_channel_registry[EP_MAX_CHANNELS];\n")
    set ok to append_list(lines and "static int ep_channel_count = 0;\n")
    set ok to append_list(lines and "static pthread_mutex_t ep_channel_registry_mutex = PTHREAD_MUTEX_INITIALIZER;\n")
    set ok to append_list(lines and "\n")
    set ok to append_list(lines and "static void ep_register_channel(EpChannel* chan) {\n")
