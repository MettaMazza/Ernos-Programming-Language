    set ok to append_list(lines and "        ep_thread_gc_states[ep_thread_slot]->sp =\n")
    set ok to append_list(lines and "            (ep_gc_root_sp < EP_GC_MAX_ROOTS) ? ep_gc_root_sp : EP_GC_MAX_ROOTS;\n")
    set ok to append_list(lines and "    }\n")
    set ok to append_list(lines and "}\n")
    set ok to append_list(lines and "\n")
    set ok to append_list(lines and "/* Park the calling thread if the collector has stopped the world.\n")
    set ok to append_list(lines and "   MUST be called with ep_gc_mutex held. The thread's shadow stack (its precise\n")
    set ok to append_list(lines and "   root set) is stable while parked, so the collector can scan it race-free. */\n")
    set ok to append_list(lines and "static void ep_gc_park_if_stopped(void) {\n")
