    set ok to append_list(lines and "        vm_size_t sz = 1;\n")
    set ok to append_list(lines and "        kern_return_t kr = vm_read_overwrite(mach_task_self(), (mach_vm_address_t)val, 1, (mach_vm_address_t)&probe, &sz);\n")
