    set ok to append_list(lines and "    while (*end && *end != '\"') { if (*end == '\\\\') end++; end++; }\n")
    set ok to append_list(lines and "    size_t len = end - val;\n")
    set ok to append_list(lines and "    char* result = (char*)malloc(len + 1);\n")
