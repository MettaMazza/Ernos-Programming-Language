    set ok to append_list(lines and "            if (ep_thread_gc_states[i]) {\n")
    set ok to append_list(lines and "                ep_thread_gc_states[i]->sp = 0;\n")
    set ok to append_list(lines and "            }\n")
    set ok to append_list(lines and "            __sync_synchronize();  /* Memory barrier: sp=0 visible before deactivation */\n")
    set ok to append_list(lines and "            ep_thread_active[i] = 0;\n")
    set ok to append_list(lines and "            ep_thread_slot = -1;\n")
    set ok to append_list(lines and "            break;\n")
    set ok to append_list(lines and "        }\n")
    set ok to append_list(lines and "    }\n")
    return join_strings(lines)

