    set ok to append_list(lines and "        EpGCEntry* new_table = (EpGCEntry*)calloc(new_cap, sizeof(EpGCEntry));\n")
    set ok to append_list(lines and "        EpGCEntry* old_table = ep_gc_table;\n")
    set ok to append_list(lines and "        ep_gc_table = new_table;\n")
