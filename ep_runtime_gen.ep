    set ok to append_list(lines and "#else\n")
    set ok to append_list(lines and "    // Bounded connect: an unreachable peer must not block ~75s on the OS SYN\n")
    set ok to append_list(lines and "    // timeout (this stalled node startup). Non-blocking connect + 5s select, then\n")
    set ok to append_list(lines and "    // restore blocking mode for the rest of the session.\n")
    set ok to append_list(lines and "    int _ep_flags = fcntl(sockfd, F_GETFL, 0);\n")
    set ok to append_list(lines and "    fcntl(sockfd, F_SETFL, _ep_flags | O_NONBLOCK);\n")
    set ok to append_list(lines and "    int _ep_cr = connect(sockfd, (struct sockaddr*)&serv_addr, sizeof(serv_addr));\n")
