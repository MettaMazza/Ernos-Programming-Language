    set ok to append_list(lines and "\n")
    set ok to append_list(lines and "/* Global channel registry — allows GC to scan values in-transit in channel buffers.\n")
    set ok to append_list(lines and "   Without this, an object sent to a channel but not yet received has NO GC root:\n")
    set ok to append_list(lines and "   the sender has popped it, the receiver hasn't pushed it, and the channel buffer\n")
