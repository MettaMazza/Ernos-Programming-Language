    set ok to append_list(lines and "    long long result; memcpy(&result, &d, sizeof(double));\n")
    set ok to append_list(lines and "    return result;\n")
    set ok to append_list(lines and "}\n")
    set ok to append_list(lines and "\n")
    set ok to append_list(lines and "long long float_to_int(long long val) {\n")
    set ok to append_list(lines and "    double d; memcpy(&d, &val, sizeof(double));\n")
    set ok to append_list(lines and "    return (long long)d;\n")
    set ok to append_list(lines and "}\n")
    set ok to append_list(lines and "\n")
    return join_strings(lines)

