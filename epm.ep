import "string"
import "json"

# epm: ErnosPlain Package Manager

define get_repo_name with url:
    set len to string_length(url)
    set idx to len - 1
    set found to 0
    repeat while idx is greater than 0 && found == 0:
        set c to get_character(url and idx)
        if c == 47: # '/'
            set found to 1
        else:
            set idx to idx - 1
    if found == 1:
        set start to idx + 1
        set repo_len to len - start
        set name to substring(url and start and repo_len)
        set name_len to string_length(name)
        if name_len > 4:
            set ext to substring(name and name_len - 4 and 4)
            if ".git" equals ext:
                return substring(name and 0 and name_len - 4)
        return name
    return url

define main:
    set argc to get_argument_count()
    if argc is less than 2:
        display "Usage:"
        display "  epm init"
        display "  epm install <git-url>"
        display "  epm build <file.ep>"
        return 1

    set cmd to get_argument(1)
    
    if cmd equals "init":
        display "Initializing new ErnosPlain project..."
        set default_json to "{\n  \"name\": \"my_ernosplain_project\",\n  \"version\": \"1.0.0\",\n  \"dependencies\": {}\n}\n"
        set ok to write_file_content("Package.json" and default_json)
        if ok == 1:
            display "Created Package.json successfully!"
        else:
            display "Error: Failed to write Package.json"
        return 0

    if cmd equals "install":
        if argc is less than 3:
            display "Error: Please specify a git URL to install."
            display "Usage: epm install <git-url>"
            return 1
            
        set url to get_argument(2)
        set repo_name to get_repo_name(url)
        display "Installing package from:"
        set ok to display_string(url)
        display "Package name:"
        set ok to display_string(repo_name)
        
        # 1. Create ep_modules directory
        set ok to run_command("mkdir -p ep_modules")
        
        # 2. Run git clone
        set clone_cmd to string_concat("git clone " and url)
        set clone_cmd to string_concat(clone_cmd and " ep_modules/")
        set clone_cmd to string_concat(clone_cmd and repo_name)
        
        display "Cloning repository..."
        set ok to display_string(clone_cmd)
        set status to run_command(clone_cmd)
        if status != 0:
            display "Error: Git clone failed."
            return 1
            
        display "Successfully cloned package!"
        
        # 3. Add to Package.json if it exists
        set pkg_content to read_file_content("Package.json")
        if string_length(pkg_content) is greater than 0:
            set parsed to json_parse(pkg_content)
            if parsed != 0:
                set deps_node to get_json_object_value(parsed and "dependencies")
                if deps_node != 0:
                    set dep_keys to get_list(deps_node and 1)
                    set dep_vals to get_list(deps_node and 2)
                    
                    # Append new dependency
                    set ok to append_list(dep_keys and repo_name)
                    set ok to append_list(dep_vals and create_json_string(url))
                    
                    set updated_json to json_stringify(parsed)
                    set ok to write_file_content("Package.json" and updated_json)
                    display "Updated Package.json dependencies."
        return 0

    if cmd equals "build":
        if argc is less than 3:
            display "Error: Please specify the main entry file to build."
            display "Usage: epm build <file.ep>"
            return 1
            
        set file to get_argument(2)
        display "Building project..."
        set build_cmd to string_concat("epc " and file)
        set ok to display_string(build_cmd)
        set status to run_command(build_cmd)
        if status == 0:
            display "Build succeeded!"
        else:
            display "Build failed."
        return status

    display "Unknown command: "
    set ok to display_string(cmd)
    return 1
